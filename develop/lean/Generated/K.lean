def KToRawEdge (q : Fin 198) (c : Fin 4) : Fin 198 := Fin.ofNat 198 (KToRawEdgeTree.get (q.val*4+c.val))

theorem KToRawValid : CoverValid K KRaw KToRawNode 0 KToRawEdge := by decide +kernel

theorem KToRaw (w) : accepts K w → accepts KRaw w :=
  cover_inclusion _ _ _ _ _ KToRawValid w

theorem KSound (w) (hw : accepts K w) :
    ∃ u, u.map KLetter = w ∧ accepts KProduct u :=
  projection_sound _ _ _ _ (projectionCheck_valid _ _ _ _ KProjectionCheck) w (KToRaw w hw)

