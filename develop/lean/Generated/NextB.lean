def NextBToRawEdge (q : Fin 91) (c : Fin 4) : Fin 91 := Fin.ofNat 91 (NextBToRawEdgeTree.get (q.val*4+c.val))

theorem NextBToRawValid : CoverValid NextB NextBRaw NextBToRawNode 0 NextBToRawEdge := by decide +kernel

theorem NextBToRaw (w) : accepts NextB w → accepts NextBRaw w :=
  cover_inclusion _ _ _ _ _ NextBToRawValid w

theorem NextBSound (w) (hw : accepts NextB w) :
    ∃ u, u.map NextBLetter = w ∧ accepts NextBProduct u :=
  projection_sound _ _ _ _ (projectionCheck_valid _ _ _ _ NextBProjectionCheck) w (NextBToRaw w hw)

