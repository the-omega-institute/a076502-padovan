def BKToRawEdge (q : Fin 129) (c : Fin 4) : Fin 129 := Fin.ofNat 129 (BKToRawEdgeTree.get (q.val*4+c.val))

theorem BKToRawValid : CoverValid BK BKRaw BKToRawNode 0 BKToRawEdge := by decide +kernel

theorem BKToRaw (w) : accepts BK w → accepts BKRaw w :=
  cover_inclusion _ _ _ _ _ BKToRawValid w

theorem BKSound (w) (hw : accepts BK w) :
    ∃ u, u.map BKLetter = w ∧ accepts BKProduct u :=
  projection_sound _ _ _ _ (projectionCheck_valid _ _ _ _ BKProjectionCheck) w (BKToRaw w hw)

